# Normalize line endings: store text as LF in the repo, check out
# platform-native on working trees. Git auto-detects which files are text.
* text=auto

# Scripts that must stay LF even on Windows checkouts
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf

# Windows-only scripts stay CRLF
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files: never convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
